# Konfigurasi backend FastAPI (student-assistant).
#
# Salin file ini jadi .env lalu isi kredensial akun service.
#
# config/settings.py memuat .env ini otomatis saat start — variabel yang
# sudah ada di environment sistem tetap menang, jadi menimpa per-sesi tetap
# bisa lewat:
#
#   set AKADEMIA_API_URL=http://127.0.0.1:8022/api/v1
#   python manage.py runserver
#
# Port default backend FastAPI (lihat run_api.bat): 8022.

# Base URL API backend FastAPI (termasuk prefix /api/v1).
AKADEMIA_API_URL=http://127.0.0.1:8022/api/v1

# Akun service yang dipakai dashboard untuk memanggil backend.
AKADEMIA_API_EMAIL=service@akademia.app
AKADEMIA_API_PASSWORD=ganti-password-di-sini

# Debug Django.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=ganti-dengan-kunci-acak-yang-panjang

# Host yang boleh membuka halaman dashboard.
#
# PENTING: host yang sama juga harus didaftarkan di
# ALLOWED_WS_ORIGINS pada .env backend FastAPI (repo
# student-assistant/backend). Dua setelan itu menjaga lompatan berbeda
# dan tidak связа otomatis:
#
#   DJANGO_ALLOWED_HOSTS  -> boleh-tidaknya browser membuka halaman dashboard
#   ALLOWED_WS_ORIGINS    -> boleh-tidaknya halaman itu membuka socket live
#
# Kalau hanya satu yang diisi, gejalanya: "halaman dashboard terbuka,
# tapi semua rekaman live ditolak server" — dan rekaman itu hilang.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
